{
  "$id": "https://movie-review-ai/schemas/render.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One render timeline segment (spec section 44).",
  "properties": {
    "clip_end": {
      "exclusiveMinimum": 0.0,
      "title": "Clip End",
      "type": "number"
    },
    "clip_start": {
      "minimum": 0.0,
      "title": "Clip Start",
      "type": "number"
    },
    "duration": {
      "exclusiveMinimum": 0.0,
      "title": "Duration",
      "type": "number"
    },
    "loop_clip": {
      "default": false,
      "title": "Loop Clip",
      "type": "boolean"
    },
    "paragraph_id": {
      "minLength": 1,
      "title": "Paragraph Id",
      "type": "string"
    },
    "scene_id": {
      "minLength": 1,
      "title": "Scene Id",
      "type": "string"
    },
    "start": {
      "minimum": 0.0,
      "title": "Start",
      "type": "number"
    }
  },
  "required": [
    "paragraph_id",
    "start",
    "duration",
    "scene_id",
    "clip_start",
    "clip_end"
  ],
  "title": "render",
  "type": "object"
}
